<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="testbench_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="testbench" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="57.000 ns"></ZoomStartTime>
      <ZoomEndTime time="122.401 ns"></ZoomEndTime>
      <Cursor1Time time="95.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="92"></NameColumnWidth>
      <ValueColumnWidth column_width="58"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject fp_name="/testbench/in" type="array">
      <obj_property name="ElementShortName">in[2:0]</obj_property>
      <obj_property name="ObjectShortName">in[2:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/testbench/out" type="array">
      <obj_property name="ElementShortName">out[2:0]</obj_property>
      <obj_property name="ObjectShortName">out[2:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/testbench/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/testbench/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
</wave_config>
